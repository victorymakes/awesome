      "description": "Mono keyword field with inline submit affordance.",
      "html": "<div class=\"ds-search\"><svg class=\"ds-search-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.35-4.35\"/></svg><input class=\"ds-search-input\" type=\"search\" aria-label=\"Search resources\" placeholder=\"Search resources\"/><button class=\"ds-search-submit\" aria-label=\"Search resources\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button></div>",
      "css": ".ds-search{position:relative;color:var(--foreground,#090909);}.ds-search-input{width:100%;height:56px;border:1px solid var(--input,#545559);border-radius:var(--radius-md,6px);background:var(--background,#f8f8f8);color:inherit;padding:0 56px 0 80px;font:16px var(--font-mono,\"Roboto Mono\",monospace);}.ds-search-input::placeholder{color:var(--muted-foreground,oklch(0.435 0.008 265));}.ds-search-icon{position:absolute;left:30px;top:18px;pointer-events:none;}.ds-search-submit{position:absolute;right:8px;top:8px;width:40px;height:40px;display:grid;place-items:center;border:0;border-radius:6px;background:transparent;color:var(--primary,#0838d3);cursor:pointer;}.ds-search-submit:hover{background:var(--accent,oklch(0.928 0.014 265));}.ds-search-input:focus-visible,.ds-search-submit:focus-visible{outline:2px solid var(--ring,#0838d3);outline-offset:4px;}@media(min-width:640px){.ds-search-input{height:60px;font-size:18px;}.ds-search-icon{top:20px;}.ds-search-submit{top:10px;}}"
