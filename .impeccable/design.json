    {
      "name": "Resource Row",
      "kind": "card",
      "refersTo": "resource-row",
      "description": "A flat ruled row with a shared hover response. On the unfiltered first page only, LaunchSaaS gains an inline Featured badge, primary tint, and filled outbound action. Both themes share a complete 1px border, primary title, and filled Featured badge. Only surface and border color opacity vary by theme.",
      "html": "<article class=\"ds-row\"><h2 class=\"ds-row-title\"><a class=\"ds-row-link\" href=\"#resource\">LaunchSaaS</a></h2><p class=\"ds-row-summary\">Launch-ready SaaS, directory, and AI app templates built with Next.js and TanStack Start.</p><span class=\"ds-row-tags\">Next.js, Better Auth, Stripe</span><a class=\"ds-row-visit\" href=\"#resource\">Visit website <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a></article>",
      "css": ".ds-row{display:grid;gap:16px;padding:24px 0;border-bottom:1px solid var(--border,#b9b9bc);color:var(--foreground,#090909);transition:background-color 150ms;}.ds-row:hover{background:color-mix(in oklab,var(--muted,oklch(0.945 0.002 265)) 35%,transparent);}.ds-row-title{margin:0;font:700 24px/1.25 var(--font-sans,\"Mona Sans\",sans-serif);letter-spacing:-.025em;overflow-wrap:anywhere;}.ds-row-link{color:inherit;text-decoration:none;}.ds-row:hover .ds-row-link,.ds-row-link:focus-visible{color:var(--primary,#0838d3);}.ds-row-summary{margin:0;font:14px/1.625 var(--font-sans,\"Mona Sans\",sans-serif);}.ds-row-tags{font:12px/1.625 var(--font-mono,\"Roboto Mono\",monospace);}.ds-row-visit{display:inline-flex;align-items:center;gap:8px;min-height:40px;color:var(--primary,#0838d3);font:600 14px/20px var(--font-mono,\"Roboto Mono\",monospace);text-decoration:none;}.ds-row-visit:hover{text-decoration:underline;}.ds-row-visit svg{transition:transform 150ms;}.ds-row:hover .ds-row-visit svg{transform:translateX(4px);}.ds-row a:focus-visible{outline:2px solid var(--ring,#0838d3);outline-offset:4px;}@media(min-width:1024px){.ds-row{grid-template-columns:minmax(0,1.095fr) minmax(0,1.336fr) minmax(0,1fr) auto;align-items:center;gap:28px;padding:14px 0;min-height:84px;}.ds-row-title{font-size:clamp(1.4rem,2.25vw,2.2rem);}.ds-row-summary,.ds-row-tags{font:17px/1.625 var(--font-mono,\"Roboto Mono\",monospace);}.ds-row-tags{border-left:1px solid var(--border,#b9b9bc);padding-left:28px;}.ds-row-visit{font-size:18px;}}@media(prefers-reduced-motion:reduce){.ds-row,.ds-row-visit svg{transition-duration:.01ms;}.ds-row:hover .ds-row-visit svg{transform:none;}}"
    },
    {
      "name": "FAQ Accordion Item",
      "kind": "custom",
      "refersTo": "faq-item",
      "description": "A framework-free visual specimen of the first disclosure in a FAQ group.",
      "html": "<details class=\"ds-faq\" open><summary class=\"ds-faq-question\">How do I contribute?<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></summary><p class=\"ds-faq-answer\">Contributions happen through GitHub. Add an accurate description and a working URL.</p></details>",
      "css": ".ds-faq{border-bottom:1px solid var(--border,#b9b9bc);color:var(--foreground,#090909);font-family:var(--font-sans,\"Mona Sans\",sans-serif);}.ds-faq-question{display:flex;justify-content:space-between;gap:24px;padding:20px 0;list-style:none;cursor:pointer;font-size:18px;font-weight:600;line-height:1.375;letter-spacing:-.025em;}.ds-faq:first-child .ds-faq-question{padding-top:0;}.ds-faq-question::-webkit-details-marker{display:none;}.ds-faq-question:hover{color:var(--primary,#0838d3);}.ds-faq-question:focus-visible{outline:2px solid var(--ring,#0838d3);outline-offset:4px;}.ds-faq-question svg{flex-shrink:0;transition:transform 200ms;}.ds-faq[open] .ds-faq-question svg{transform:rotate(180deg);}.ds-faq-answer{max-width:75ch;margin:0;padding-bottom:28px;color:var(--muted-foreground,oklch(0.435 0.008 265));font-size:16px;line-height:1.625;}@media(min-width:640px){.ds-faq-question{font-size:20px;}.ds-faq-answer{font-size:18px;}}@media(prefers-reduced-motion:reduce){.ds-faq-question svg{transition-duration:.01ms;}}"
    }
  ],
  "narrative": {
    "northStar": "Type & Space / Quiet Monument",
    "overview": "Type & Space gives light mode a pale ground, dense black display type, and cobalt actions. Quiet Monument carries the same structure into matte dark surfaces, soft white text, and a pale action color. Scale and whitespace establish hierarchy; monospace text makes navigation, controls, and resource metadata feel precise.\n\nThe directory is a ruled index rather than a gallery. Resource titles carry the strongest weight below the hero, with summaries, technology labels, and outbound actions arranged for scanning. FAQ content uses the same type contrast and rules, with longer answers given a readable measure.",
    "keyCharacteristics": [
      "Oversized proportional headlines paired with restrained monospace utilities.",
      "One responsive information structure and identical hero composition across light and dark themes.",
      "Flat page surfaces, visible rules, and minimally rounded controls.",
      "Brief state feedback with reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Use semantic background, foreground, primary, muted, border, input, and ring roles in product UI; let the active theme supply their values.",
        "section": "colors"
      },
      {
        "name": "The Type Contrast Rule",
        "body": "Use proportional faces for display and content hierarchy, and the mono face for navigation, filtering, and compact metadata.",
        "section": "typography"
      },
      {
        "name": "The Flat Index Rule",
        "body": "Keep directory rows flat and separated by rules; reserve elevation for overlays and floating detail surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse shadcn Button, Select, Popover, Command, Sheet, and Accordion behavior and apply semantic theme tokens.",
      "Do keep the same content order and controls in both themes, including the mobile theme toggle.",
      "Do preserve visible keyboard focus, readable wrapping, and reduced-motion behavior.",
      "Do use inline SVG icons for arrows, toggles, and search affordances.",
      "Do highlight LaunchSaaS only on the unfiltered first page; search and filter results use ordinary resource rows."
    ],
    "donts": [
      "Don't hardcode a light-only color into a shared control.",
      "Don't replace the directory's ruled rows with elevated marketing cards.",
      "Don't substitute system fonts for the locally hosted display and monospace faces.",
      "Don't use the decorative wave as content or make it intercept pointer input."
    ]
  }
}
