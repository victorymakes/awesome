      "html": "<button class=\"ds-button-primary\">Submit a resource</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:var(--radius-md,6px);height:40px;padding:8px 16px;font:500 14px/20px var(--font-sans,\"Mona Sans\",sans-serif);text-decoration:none;cursor:pointer;transition:color 150ms,background-color 150ms;background:var(--primary,#0838d3);color:var(--primary-foreground,#fff);border:0;}.ds-button-primary:hover{background:color-mix(in oklab,var(--primary,#0838d3) 90%,transparent);}.ds-button-primary:focus-visible{outline:2px solid var(--ring,#0838d3);outline-offset:2px;}.ds-button-primary:disabled{opacity:.5;pointer-events:none;} @media(prefers-reduced-motion:reduce){.ds-button-primary{transition-duration:.01ms;}}"
    },
